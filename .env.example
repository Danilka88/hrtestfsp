# --- Приложение ---
ENVIRONMENT=local
DEBUG=true

# --- Порты на хосте ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Безопасность (заменить в реальном окружении) ---
JWT_SECRET=change-me-in-env
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# --- Провайдеры: mock | real ---
LLM_PROVIDER=mock
FSP_PROVIDER=mock
EMAIL_PROVIDER=mock
STORAGE_PROVIDER=mock

# --- Правила продукта ---
GRADE_CHANGE_COOLDOWN_DAYS=90
