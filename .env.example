# --- Приложение ---
ENVIRONMENT=local
DEBUG=true

# --- Порты на хосте ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Безопасность (заменить в реальном окружении) ---
# В не-локальном окружении (ENVIRONMENT != local) требуется секрет длиной ≥32 символов
# без подстрок 'change-me' / 'insecure' — иначе приложение не стартует.
JWT_SECRET=dev-insecure-secret-change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Демо-режим: токен подтверждения email возвращается в ответе API.
# В продакшене обязательно false.
EXPOSE_DEV_TOKENS=true

# --- Провайдеры внешних сервисов ---
FSP_PROVIDER=mock
EMAIL_PROVIDER=mock
STORAGE_PROVIDER=mock

# --- ИИ: локальная открытая модель через Ollama ---
# auto   — пробовать локальную модель; если её нет, платформа работает на
#          демо-данных, а ответы помечаются degraded=true (рекомендуется);
# ollama — только реальная модель: ошибка, если она недоступна (для отладки);
# mock   — только демо-данные, без обращений наружу (полностью офлайн).
LLM_PROVIDER=auto

# Адрес Ollama. Из контейнера host-машина доступна как host.docker.internal;
# при запуске API без Docker укажите http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Пусто = выбрать модель автоматически из уже скачанных.
# Подходит любая открытая модель: gemma4, gemma3, qwen3, llama3, mistral и др.
# Примеры: gemma4:12b-mlx, gemma3:4b, qwen3:8b
OLLAMA_MODEL=
# Пусто = выбрать модель эмбеддингов автоматически (qwen3-embedding, bge-m3, …)
OLLAMA_EMBED_MODEL=

# Режим рассуждений модели. Для коротких задач (извлечение полей, черновики)
# выключен: на Gemma 4 включённый reasoning замедляет ответ примерно в 40 раз.
LLM_THINK=false

# Семантическое сопоставление потребности и профиля через эмбеддинги
SEMANTIC_MATCH_ENABLED=true

# --- Аутентификация: local | keycloak ---
# local    — собственная аутентификация (Argon2 + JWT), активна в MVP;
# keycloak — задел под ФСП ID: обмен учётных данных на токены realm и проверка
#            id_token по JWKS. Требует заполненных параметров ниже.
AUTH_PROVIDER=local
# KEYCLOAK_BASE_URL=https://keycloak.example.ru
# KEYCLOAK_REALM=fsp
# KEYCLOAK_CLIENT_ID=it-talent-match
# KEYCLOAK_CLIENT_SECRET=

# --- Правила продукта ---
GRADE_CHANGE_COOLDOWN_DAYS=90
